# Copy this file to .env (it is git-ignored) and fill in your connection string.
# config.py loads it automatically; if MONGO_URI is unset it falls back to a
# local MongoDB at mongodb://localhost:27017 (see docker-compose.yml).

# MongoDB Atlas (your own cluster, NOT the read-only class cluster from HW6).
# Copy it from Atlas -> Connect -> Drivers. Keep it on ONE line, and
# URL-encode special characters in the password (e.g. @ -> %40).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Local MongoDB running in Docker instead:
# MONGO_URI=mongodb://localhost:27017

# Optional: override the database names (defaults shown).
# USERS_DB_NAME=Users
# PROJECTS_DB_NAME=Projects
# HARDWARE_DB_NAME=HardwareSet
